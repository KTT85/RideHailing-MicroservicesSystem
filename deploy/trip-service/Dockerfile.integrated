FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY src/trip-service/package*.json ./
RUN npm ci
COPY src/trip-service/prisma ./prisma
RUN npm run prisma:generate
COPY src/trip-service/tsconfig.json ./
COPY src/trip-service/src ./src
RUN npm run build
COPY deploy/trip-service/start-integrated.sh /app/start-integrated.sh
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "/app/start-integrated.sh"]
