RABBITMQ_USER=ride_local
RABBITMQ_PASSWORD=local_dev_change_me
MYSQL_ROOT_PASSWORD=local_root_change_me
MYSQL_USER_PASSWORD=local_user_change_me
MYSQL_DRIVER_PASSWORD=local_driver_change_me
MYSQL_TRIP_PASSWORD=local_trip_change_me
MYSQL_PAYMENT_PASSWORD=local_payment_change_me
MYSQL_NOTIFICATION_PASSWORD=local_notification_change_me
# Generate locally; use the same JWT_SECRET for User and Payment. Do not commit real values.
JWT_SECRET=
PAYMENT_INTERNAL_TOKEN=
# Host ports only; containers always connect to rabbitmq:5672 and Payment:8080.
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
PAYMENT_HTTP_PORT=8085
JWT_ISSUER=ds03-user-service
