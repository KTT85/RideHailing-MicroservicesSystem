          "script": {
            "exec": [
              "if (!pm.collectionVariables.get('cashTripId')) pm.collectionVariables.set('cashTripId', pm.variables.replaceIn('{{$' + 'guid}}'));\nif (!pm.collectionVariables.get('correlationId')) pm.collectionVariables.set('correlationId', pm.variables.replaceIn('{{$' + 'guid}}'));\nif (!pm.collectionVariables.get('cashConfirmedEventId')) pm.collectionVariables.set('cashConfirmedEventId', pm.variables.replaceIn('{{$' + 'guid}}'));\nconst trip = pm.collectionVariables.get('cashTripId');\nconst envelope = {eventId:pm.collectionVariables.get('cashConfirmedEventId'),eventType:'CashPaymentConfirmationRequested',correlationId:pm.collectionVariables.get('correlationId'),timestamp:new Date().toISOString(),payload:{tripId:trip,passengerId:pm.collectionVariables.get('passengerId'),method:'CASH',amount:50000,currency:'VND'}};\nif ('CONFIRM_CASH') envelope.payload.idempotencyKey=trip+':'+'CONFIRM_CASH';\npm.variables.set('brokerPublishBody', JSON.stringify({properties:{delivery_mode:2,content_type:'application/json'},routing_key:'CashPaymentConfirmationRequested',payload:JSON.stringify(envelope),payload_encoding:'string'}));"
            ],
