    {
      "request": {
        "url": "{{userBase}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "raw": "{\"identifier\":\"{{loginIdentifier}}\",\"password\":\"{{loginPassword}}\"}",
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "method": "POST"
      },
      "name": "01 Login Passenger (User service)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login OK',()=>pm.response.to.have.status(200)); if(pm.response.code===200){const r=pm.response.json(); pm.collectionVariables.set('accessToken',r.accessToken); pm.collectionVariables.set('passengerId',r.user.id);}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
