          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get('cashTripId')) pm.collectionVariables.set('cashTripId', pm.variables.replaceIn('{{$' + 'guid}}'));\nif (!pm.collectionVariables.get('correlationId')) pm.collectionVariables.set('correlationId', pm.variables.replaceIn('{{$' + 'guid}}'));\nif (!pm.collectionVariables.get('cashCompletedEventId')) pm.collectionVariables.set('cashCompletedEventId', pm.variables.replaceIn('{{$' + 'guid}}'));\nconst trip = pm.collectionVariables.get('cashTripId');\nconst envelope = {eventId:pm.collectionVariables.get('cashCompletedEventId'),eventType:'TripCompleted',correlationId:pm.collectionVariables.get('correlationId'),timestamp:new Date().toISOString(),payload:{tripId:trip,passengerId:pm.collectionVariables.get('passengerId'),method:'CASH',amount:50000,currency:'VND'}};\nif ('') envelope.payload.idempotencyKey=trip+':'+'';\npm.variables.set('brokerPublishBody', JSON.stringify({properties:{delivery_mode:2,content_type:'application/json'},routing_key:'TripCompleted',payload:JSON.stringify(envelope),payload_encoding:'string'}));"
            ],
            "type": "text/javascript"
          }
        }
