      "name": "08 Full REFUND (simulates Trip cancellation Saga)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get('tripId')) pm.collectionVariables.set('tripId', pm.variables.replaceIn('{{$' + 'guid}}'));\nif (!pm.collectionVariables.get('correlationId')) pm.collectionVariables.set('correlationId', pm.variables.replaceIn('{{$' + 'guid}}'));\nif (!pm.collectionVariables.get('refundEventId')) pm.collectionVariables.set('refundEventId', pm.variables.replaceIn('{{$' + 'guid}}'));\nconst trip = pm.collectionVariables.get('tripId');\nconst envelope = {eventId:pm.collectionVariables.get('refundEventId'),eventType:'PaymentRefundRequested',correlationId:pm.collectionVariables.get('correlationId'),timestamp:new Date().toISOString(),payload:{tripId:trip,passengerId:pm.collectionVariables.get('passengerId'),method:'TRANSFER',amount:50000,currency:'VND'}};\nif ('REFUND') envelope.payload.idempotencyKey=trip+':'+'REFUND';\npm.variables.set('brokerPublishBody', JSON.stringify({properties:{delivery_mode:2,content_type:'application/json'},routing_key:'PaymentRefundRequested',payload:JSON.stringify(envelope),payload_encoding:'string'}));"
            ],
            "type": "text/javascript"
          }
        }
      ]
