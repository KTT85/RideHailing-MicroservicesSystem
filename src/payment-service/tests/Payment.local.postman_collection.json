      "name": "05 TRANSFER PAY (simulates trusted Trip)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get('tripId')) pm.collectionVariables.set('tripId', pm.variables.replaceIn('{{$' + 'guid}}'));\nif (!pm.collectionVariables.get('correlationId')) pm.collectionVariables.set('correlationId', pm.variables.replaceIn('{{$' + 'guid}}'));\nif (!pm.collectionVariables.get('payEventId')) pm.collectionVariables.set('payEventId', pm.variables.replaceIn('{{$' + 'guid}}'));\nconst trip = pm.collectionVariables.get('tripId');\nconst envelope = {eventId:pm.collectionVariables.get('payEventId'),eventType:'PaymentRequested',correlationId:pm.collectionVariables.get('correlationId'),timestamp:new Date().toISOString(),payload:{tripId:trip,passengerId:pm.collectionVariables.get('passengerId'),method:'TRANSFER',amount:50000,currency:'VND'}};\nif ('PAY') envelope.payload.idempotencyKey=trip+':'+'PAY';\npm.variables.set('brokerPublishBody', JSON.stringify({properties:{delivery_mode:2,content_type:'application/json'},routing_key:'PaymentRequested',payload:JSON.stringify(envelope),payload_encoding:'string'}));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "request": {
        "url": "{{rabbitBase}}/api/exchanges/%2F/ride.events/publish",
        "auth": {
          "basic": [
