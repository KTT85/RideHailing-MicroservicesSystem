{
  "name": "notification-service-rest",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": "20.x" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node dist/server.js",
    "start": "node dist/server.js",
    "test": "npm run build && tsc -p tsconfig.test.json && jest --runInBand"
  },
  "dependencies": { "express": "4.21.2", "pino": "9.6.0", "zod": "3.24.1" },
  "devDependencies": {
    "@types/express": "4.17.21", "@types/jest": "29.5.14", "@types/node": "20.17.10",
    "@types/supertest": "6.0.2", "jest": "29.7.0", "supertest": "7.0.0", "typescript": "5.7.2"
  },
  "jest": {
    "testEnvironment": "node", "roots": ["<rootDir>/dist/tests/notification-service"],
    "testMatch": ["**/notification.rest.test.js"], "cacheDirectory": "<rootDir>/.jest-cache"
  }
}
