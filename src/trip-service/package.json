{
  "name": "trip-service-data",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/integrated-server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/integrated-server.js",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "messaging:dev": "tsx src/messaging/messaging-main.ts",
    "build:messaging": "tsc -p tsconfig.messaging.json",
    "dev:mock": "tsx watch src/server.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1",
    "amqplib": "0.10.9"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "20.17.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "@types/amqplib": "0.10.7"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "../../tests/trip-service"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.test.json"
        }
      ]
    },
    "cacheDirectory": "<rootDir>/.jest-cache",
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
