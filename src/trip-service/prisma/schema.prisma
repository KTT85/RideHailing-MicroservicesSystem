generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  REQUESTED
  MATCHING
  DRIVER_ASSIGNED
  MATCHED
  ACCEPTED
  STARTING
  REJECTED
  IN_PROGRESS
  COMPLETED
  PAYMENT_PENDING
  PAYMENT_FAILED
  COMPENSATING
  CANCELLED

  @@map("trip_status")
}

model Trip {
  id             String     @id @default(uuid()) @db.Char(36)
  passengerId    String     @map("passenger_id") @db.Char(36)
  driverId       String?    @map("driver_id") @db.Char(36)
  status         TripStatus @default(REQUESTED)
  pickup         Json
  dropoff        Json
  fare           Float?
  paymentId      String?    @map("payment_id")
  idempotencyKey String     @unique @map("idempotency_key") @db.VarChar(255)
  requestedAt    DateTime   @default(now()) @map("requested_at") @db.DateTime(3)
  acceptedAt     DateTime?  @map("accepted_at") @db.DateTime(3)
  startedAt      DateTime?  @map("started_at") @db.DateTime(3)
  completedAt    DateTime?  @map("completed_at") @db.DateTime(3)
  cancelledAt    DateTime?  @map("cancelled_at") @db.DateTime(3)
  cancelReason   String?    @map("cancel_reason")
  correlationId  String?    @map("correlation_id") @db.Char(36)
  vehicleType    String?    @map("vehicle_type")
  paymentMethod  String?    @map("payment_method")
  paymentState   String?    @map("payment_state")
  driverReleased Boolean    @default(false) @map("driver_released")
  driverUserId   String?    @map("driver_user_id") @db.Char(36)
  demoFault      String?    @map("demo_fault")
  demoFaultAt    DateTime?  @map("demo_fault_at") @db.DateTime(3)

  @@index([passengerId, requestedAt])
  @@index([driverId, requestedAt])
  @@index([status])
  @@map("trips")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Char(36)
  aggregateId   String    @map("aggregate_id") @db.Char(36)
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json
  correlationId String    @map("correlation_id") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  publishedAt   DateTime? @map("published_at") @db.DateTime(3)

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Char(36)
  processedAt DateTime @default(now()) @map("processed_at") @db.DateTime(3)

  @@map("processed_events")
}

model TripWorkflowLock {
  id Int @id

  @@map("trip_workflow_lock")
}
